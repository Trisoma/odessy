{
  "name": "@odessy/tool-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test \"dist/tests/*.test.js\"",
    "start": "npm run build --silent && node dist/src/server.js",
    "start:http": "npm run build --silent && node dist/src/server.js --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
