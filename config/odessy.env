# Odessy default configuration (committed; shared by everyone).
#
# Put your own machine-specific settings in ~/.config/odessy/odessy.env instead of
# editing this file. Precedence: environment variables, then that user file, then
# this file. `python -m odessy doctor` shows which files were found.

# Deployment: single (one computer runs everything; the default when no remote tool
# server is configured) or split (a Jetson runs the model and voice, a laptop runs
# the Node tool server). When unset, setting ODESSY_TOOL_SERVER_URL selects split.
# ODESSY_DEPLOYMENT=single

ODESSY_WHISPER_BIN=$HOME/whisper.cpp/build/bin/whisper-cli
ODESSY_WHISPER_MODEL=$HOME/whisper.cpp/models/ggml-tiny.en.bin

# Kokoro ONNX Runtime model
ODESSY_KOKORO_MODEL=$HOME/odessy-voice-test/kokoro-v1.0.int8.onnx
ODESSY_KOKORO_VOICES=$HOME/odessy-voice-test/voices-v1.0.bin

# Kokoro PyTorch model directory
ODESSY_KOKORO_PYTORCH_MODEL_DIR=$HOME/models/Kokoro-82M

# ODESSY_OLLAMA_MODEL=lfm2.5-thinking:q6
# ODESSY_MODEL_NAME=lfm2.5-thinking:q6
ODESSY_OLLAMA_MODEL=lfm2.5-thinking:1.2b-q8_0
ODESSY_MODEL_NAME=lfm2.5-thinking:1.2b-q8_0
ODESSY_MODEL_ENDPOINT=http://127.0.0.1:11434

# Maximum seconds of silence allowed between streamed chunks from Ollama.
# This is an IDLE timeout, not a total generation budget: the timer resets on
# every received chunk, so a healthy model may generate for minutes as long as
# chunks keep arriving. Raise it if a cold model load is silent for longer.
ODESSY_MODEL_PROGRESS_TIMEOUT=120
# Limits on one local model call. Thinking tokens also consume the generation
# budget; tune these experimental defaults for your model and hardware.
# Maximum generated tokens per call.
# ODESSY_MODEL_NUM_PREDICT=1024
# Context window requested from Ollama.
# ODESSY_MODEL_NUM_CTX=8192
# Stream budget, checked between lines after response headers arrive. Connection
# and header waits are excluded; a blocking read can overrun this budget.
# ODESSY_MODEL_CALL_TIMEOUT=300

# Optional cloud model backend. Off unless selected: set ODESSY_MODEL_BACKEND
# (or pass --model-backend) to one of: claude, openai, deepseek, qwen, kimi, custom.
# A cloud backend sends your request and redacted tool output to the provider.
# Policy, authorization, and confirmation still run locally.
#
# Do not put API keys in this file (it is committed); export them in your shell:
#   claude   -> ANTHROPIC_API_KEY   (needs: pip install -e .[cloud])
#   openai   -> OPENAI_API_KEY
#   deepseek -> DEEPSEEK_API_KEY
#   qwen     -> DASHSCOPE_API_KEY
#   kimi     -> MOONSHOT_API_KEY
#   custom   -> ODESSY_CLOUD_API_KEY (any OpenAI-compatible endpoint)
# ODESSY_MODEL_BACKEND=claude
# ODESSY_CLOUD_MODEL=            # override the provider's default model
# ODESSY_CLOUD_BASE_URL=         # required for custom; e.g. dashscope-intl for Qwen outside China
# ODESSY_CLOUD_TIMEOUT=120       # seconds per request
# Claude output ceiling.
# ODESSY_CLOUD_MAX_TOKENS=16000
# OpenAI-compatible output ceiling; must fit the selected model's limits.
# ODESSY_CLOUD_OPENAI_MAX_TOKENS=4096
# ODESSY_CLOUD_EFFORT=           # Claude only: low | medium | high | xhigh | max
# ODESSY_CLOUD_FALLBACKS=on      # Claude only: server-side refusal fallbacks

# Split deployment only: the laptop's MCP server, and optionally the laptop's OS so
# the model knows which shell its commands run in (windows | linux | macos).
# Set these in ~/.config/odessy/odessy.env on the Jetson, not here.
# ODESSY_TOOL_SERVER_URL=http://10.1.1.1:8765/mcp
# ODESSY_LAPTOP_OS=windows

# Tool dispatch overlap: 1 keeps sequential execution; accepted range 1-8.
# ODESSY_TOOL_CONCURRENCY=1

# Opt-in automatic model selection (v0.4.0 development). See model-selection.mdx.
# ODESSY_MODEL_BACKEND=auto
# ODESSY_AUTO_FAST_MODEL=gemma3:1b
# ODESSY_AUTO_CAPABLE_BACKEND=lfm
# ODESSY_AUTO_CAPABLE_MODEL=lfm2.5-thinking:1.2b-q8_0
# ODESSY_AUTO_CLOUD_FALLBACK=off
# ODESSY_AUTO_CLOUD_BACKEND=deepseek
